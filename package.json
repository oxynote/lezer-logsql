{
	"name": "@oxynote/lezer-logsql",
	"version": "0.1.0",
	"description": "Lezer grammar for LogsQL, the query language of VictoriaLogs",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Oxynote",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxynote/lezer-logsql.git"
	},
	"bugs": {
		"url": "https://github.com/oxynote/lezer-logsql/issues"
	},
	"homepage": "https://github.com/oxynote/lezer-logsql#readme",
	"keywords": [
		"lezer",
		"logsql",
		"victorialogs",
		"codemirror"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"NOTICE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"generate": "lezer-generator src/logsql.grammar --typeScript --output src/parser.ts",
		"build": "pnpm run generate && tsc --project tsconfig.build.json",
		"check-types": "pnpm run generate && tsc --noEmit",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache --no-gitignore --no-config-hints",
		"check-knip": "knip --cache --no-gitignore --no-config-hints",
		"test": "pnpm run generate && vitest run --coverage",
		"test-watch": "pnpm run generate && vitest",
		"parse": "node scripts/parse.ts",
		"sync-upstream": "node scripts/sync-upstream.ts",
		"lint": "pnpm dedupe && pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm dedupe --check && pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"peerDependencies": {
		"@lezer/common": "^1.0.0",
		"@lezer/highlight": "^1.0.0",
		"@lezer/lr": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lezer/common": "^1.5.6",
		"@lezer/generator": "^1.8.1",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.12",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"@vitest/eslint-plugin": "^1.6.28",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.18.1",
		"knip": "^6.47.0",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	}
}
